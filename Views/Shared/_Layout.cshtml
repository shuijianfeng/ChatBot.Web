@* _Layout.cshtml *@
@inject ChatBot.Web.Services.IChatService ChatService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery antiforgery

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AI助手" />
    <meta name="csrf-token" content="@GetAntiForgeryToken()" />
    <meta name="user-login" content="@User.Identity.Name">
    <title>@ViewData["Title"] - AI助手</title>


    <script src="~/lib/mathjax/tex-mml-chtml.js" id="MathJax-script" async></script>
    <script>
        MathJax = {
            tex: {
                inlineMath: [['$', '$']],
                displayMath: [['$$', '$$']],
                processEscapes: true,

            },
            svg: {
                fontCache: 'global'
            },
            options: {
                skipHtmlTags: ['pre', 'code', 'script', 'noscript', 'style', 'textarea', 'match']
            },
            startup: {
                ready: () => {

                    MathJax.startup.defaultReady();


                    MathJax.startup.promise.then(() => {
                        console.log('MathJax initial typesetting complete');
                    });
                },
                pageReady: () => {
                    MathJax.startup.defaultPageReady();
                },
                typeset: false
            }
        };


    </script>

    <link rel="stylesheet" href="~/lib/jsmind/style/jsmind.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/primer/octicons/build/build.css" />
    <link rel="stylesheet" href="~/lib/highlight.js/styles/github.css" />
    <link rel="stylesheet" href="~/lib/highlight.js/styles/github-dark.css" media=" (prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* 网站图标 *@
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    @* 防止深色模式闪烁：在页面渲染前同步应用主题 *@
    <script>
        (function() {
            @if (ViewBag.DefaultTheme != null)
            {
                <text>
                // 优先使用服务器端传入的主题（如URL参数）
                var serverTheme = '@ViewBag.DefaultTheme';
                document.documentElement.setAttribute('data-theme', serverTheme);
                return;
                </text>
            }

            // 否则使用localStorage中保存的主题
            var savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-theme', savedTheme);
            }
        })();
    </script>
</head>

<body class="bg-light" id="body-main">
    <div class="app-container" id="app-container">
        @* 顶部导航栏 *@
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white fixed-top" id="navbar">
                <div class="container-fluid px-4" id="container-fluid">
                    @* 侧边栏展开按钮 *@
                    <button class="expand-sidebar-btn navbar-expand-btn" id="expand-sidebar-btn" title="展开侧边栏" style="display: flex;">
                        <i class="bi bi-layout-sidebar" style="font-size: 18px;"></i>
                    </button>
                    

                        @* 右侧工具栏 *@
                        <div class="d-flex align-items-center">
                            @* 主题切换 *@
                            <div class="theme-switch me-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="theme-toggle">
                                    <label class="form-check-label" for="theme-toggle">
                                        <i class="bi bi-sun-fill"></i>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="modeldropdown">
                                <select class="form-select form-select-sm" id="global-model-selector">
                                    @foreach (var chatModel in ChatService.GetAvailableModels())
                                    {
                                        <option value="@chatModel">@chatModel</option>
                                    }
                                </select>
                            </div>
                            <div class="px-3 py-2">
                                <label></label>

                            </div>
                            @* 设置下拉菜单 - 已移除 *@
                        </div>
                   
                </div>
            </nav>
        </header>

        @* 主要内容区域 *@
        <main role="main" class="main-content">
            @RenderBody()
        </main>

        
    </div>

    @* 基础脚本 *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.js"></script>
    <script src="~/lib/marked/marked.min.js"></script>
   
    <script src="~/lib/mermaid/dist/mermaid.min.js"></script>
    <script src="~/lib/jsmind/es6/jsmind.js"></script>
    <script src="~/lib/waveform-player/waveform-player.js"></script>
   
    <script src="~/lib/highlight.js/highlight.min.js"></script>

    <script src="~/js/chat.js?v=@Guid.NewGuid().ToString("N")"></script>


    @* 页面特定脚本 *@
    @await RenderSectionAsync("Scripts", required: false)

    @* 主题和设置管理脚本 *@
    <script>

        // 主题切换功能
        document.addEventListener('DOMContentLoaded', () => {

            @if (ViewBag.DefaultTheme != null)
                {
                    <text>
                                // 接收控制器设置的主题
                        const initialTheme = '@ViewBag.DefaultTheme';

                        localStorage.setItem('theme', initialTheme);

                    </text>
            }


                    const themeToggle = document.getElementById('theme-toggle');
            const body = document.body;
            const html = document.documentElement;

            // 加载保存的主题
            const savedTheme = localStorage.getItem('theme') || 'light';
            html.setAttribute('data-theme', savedTheme);
            body.setAttribute('data-theme', savedTheme);
            themeToggle.checked = savedTheme === 'dark';

            // 主题切换事件
            themeToggle.addEventListener('change', (e) => {
                const newTheme = e.target.checked ? 'dark' : 'light';
                html.setAttribute('data-theme', newTheme);
                body.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
            });



            // 加载保存的模型设置或默认选择第一个模型
            const modelSelector = document.getElementById('global-model-selector');
            const models = Array.from(modelSelector.options).map(option => option.value);
            const savedModel = localStorage.getItem('selectedModel');

            if (savedModel && models.includes(savedModel)) {
                modelSelector.value = savedModel;
            } else if (models.length > 0) {
                modelSelector.value = models[0];
                localStorage.setItem('selectedModel', models[0]);
            }





            // 保存模型选择
            modelSelector.addEventListener('change', (e) => {
                localStorage.setItem('selectedModel', e.target.value);
            });
        });
    </script>
    @* 屏蔽右键 *@
    <script>
        document.addEventListener('contextmenu', function (event) {
            event.preventDefault();
        });
    </script>
</body>

</html>

@functions {
    string GetAntiForgeryToken()
    {
        var tokens = antiforgery.GetAndStoreTokens(Context);
        return tokens.RequestToken;
    }
}