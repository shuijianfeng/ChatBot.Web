@model ChatBot.Models.ErrorViewModel
@{
    ViewData["Title"] = "未授权访问";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3>访问被拒绝</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h4>错误代码：@Model.ErrorCode</h4>
                        <p>@Model.Message</p>
                    </div>
                    <p>如需帮助，请联系系统管理员。</p>
                    <a href="/" class="btn btn-primary">返回首页</a>
                </div>
            </div>
        </div>
    </div>
</div>