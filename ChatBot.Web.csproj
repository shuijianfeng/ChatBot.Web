<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup><ProjectReference Include="..\hcwebnew\Hcsoft.CloudPortal\Knowledge.Shared\Knowledge.Shared.csproj" /></ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\Attachments\**;tests\ResponsesContinuation\**;tests\KnowledgeEvidence\**;tests\EmbeddingProxy\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    
  </ItemGroup>

  <ItemGroup>
    <Content Update="Views\Home\_ViewImports.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="wwwroot\css\site.css">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\chat.js">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Sharedmedia\" />
    <Folder Include="Pages\Shared\" />
    <Folder Include="Properties\PublishProfiles\" />
    <Folder Include="wwwroot\html\" />
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0" />
    <PackageReference Include="itext.bouncy-castle-fips-adapter" Version="9.7.0" />
    <PackageReference Include="itext.pdfhtml" Version="6.3.3" />
    <PackageReference Include="Lofcz.Forks.HtmlToOpenXml" Version="3.2.5" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.ClientModel" Version="1.15.0" />
    
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenAI">
      <HintPath>OpenAI.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
