{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "highlight.js@11.11.1",
      "destination": "wwwroot/lib/highlight.js/"
    },
    {
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/"
    },
    {
      "library": "bootstrap-icons@1.13.1",
      "destination": "wwwroot/lib/bootstrap-icons/"
    },
    {
      "provider": "unpkg",
      "library": "marked@17.0.3",
      "destination": "wwwroot/lib/marked/"
    },

    {
      "provider": "unpkg",
      "library": "@primer/octicons@19.22.0",
      "destination": "wwwroot/lib/primer/octicons/"
    },
    {
      "provider": "unpkg",
      "library": "mermaid@11.12.3",
      "destination": "wwwroot/lib/mermaid/"
    },

    {
      "provider": "unpkg",
      "library": "mathjax@4.1.1",

      "destination": "wwwroot/lib/mathjax/"
    }
  ]
}